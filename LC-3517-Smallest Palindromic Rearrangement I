//Have to work on strings

class Solution {
    public String smallestPalindrome(String s) {
        int n = s.length();

        if(n==1) return s;

        char[] arr = s.toCharArray();

        Arrays.sort(arr, 0, n/2);

        for(int i=0; i<n/2; i++){
            arr[n-1-i] = arr[i];
        }

        String res = new String(arr);

        return res;
    }
}
