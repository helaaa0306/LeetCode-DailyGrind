class Solution {
    public long gcdSum(int[] nums) {
        int n = nums.length;
        int max = nums[0];
        int[] prefixGCD = new int[n];
        prefixGCD[0] = nums[0];

        for(int i=1; i<n; i++){
            max = Math.max(max, nums[i]);
            prefixGCD[i] = gcd(max, nums[i]);
        }

        Arrays.sort(prefixGCD);

        int i=0, j=n-1; long sum=0;

        while(i<j){
            sum+=gcd(prefixGCD[j], prefixGCD[i]);
            i++; j--;
        }

        return sum;


    }

    int gcd(int a, int b){
        return b==0 ? a : gcd(b, a%b);
    }
}
