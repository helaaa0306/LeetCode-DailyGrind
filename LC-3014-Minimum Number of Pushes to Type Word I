class Solution {
    public int minimumPushes(String word) {
        int n = word.length();
        
        int cost = 0;
        int p = 1;
        
        while(n>0){
            if(n<8) {cost+= (n%8)*p;
            break;
            }
            else cost += p*8;
            
            p++;
            n-=8;
           
        }
        
        return cost;
    }
}
