class Solution {
    public int[] gcdValues(int[] nums, long[] queries) {
        int max = 0;
        for (int x : nums) max = Math.max(max, x);

        int[] count = new int[max + 1];
        for (int x : nums) count[x]++;

        int[] divisible = new int[max + 1];
        for (int g = 1; g <= max; g++) {
            for (int multiple = g; multiple <= max; multiple += g) {
                divisible[g] += count[multiple];
            }
        }

        long[] gcdCount = new long[max + 2];
        for (int g = max; g >= 1; g--) {
            long total = divisible[g];
            long pairsDivisible = total * (total - 1) / 2;

            for (int multiple = 2 * g; multiple <= max; multiple += g) {
                pairsDivisible-= gcdCount[multiple];
            }
            gcdCount[g] = pairsDivisible;
        }

        long[] prefix = new long[max + 1];
        for (int g = 1; g <= max; g++) {
            prefix[g] = prefix[g - 1] + gcdCount[g];
        }

        int[] answer = new int[queries.length];
        for (int i = 0; i < queries.length; i++) {
            long need = queries[i] + 1L; 
            int lo = 1, hi = max;
            while (lo < hi) {
                int mid = (lo + hi) / 2;
                if (prefix[mid] >= need) hi = mid;
                else lo = mid + 1;
            }
            answer[i] = lo;
        }

        return answer;
    }

}
