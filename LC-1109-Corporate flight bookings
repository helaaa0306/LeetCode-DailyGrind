//Line sweep method

class Solution {
    public int[] corpFlightBookings(int[][] bookings, int n) {
        int[] store = new int[n+1];

        for(int i=0; i<bookings.length; i++){
            int s = bookings[i][0]-1;
            int e = bookings[i][1];

            store[s]+= bookings[i][2];
            store[e]-= bookings[i][2];
        }

        int[] ans = new int[n];
        ans[0] = store[0];

        for(int i=1; i<n;i++){
           ans[i] = ans[i-1] + store[i];
        }

        return ans;
    }
}
