//Recursion

class Solution {

    String[] list = {
            "abc", "def", "ghi", "jkl", "mno", "pqrs", "tuv", "wxyz"
    };

    public List<String> letterCombinations(String digits) {
        return permutations("", digits);
    }

    List<String> permutations(String p, String up) {
        if (up.isEmpty()) {
            List<String> ans = new ArrayList<>();
            ans.add(p);
            return ans;
        }

        List<String> ans = new ArrayList<>();

        int idx = up.charAt(0) - '2';
        String l = list[idx];

        for (int j = 0; j < l.length(); j++) {
            char ch = l.charAt(j);

            ans.addAll(permutations(p + ch, up.substring(1)));
        }

        return ans;

    }
}
