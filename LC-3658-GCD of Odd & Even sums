class Solution {
    public int gcdOfOddEvenSums(int n) {
        long sumOdd = n*n;
        long sumEven = n*(n-1);

        return (int)gcd(sumOdd, sumEven);
    }

    long gcd(long a , long b){
        return b==0 ?  a : gcd(b, a%b);
    }
}



