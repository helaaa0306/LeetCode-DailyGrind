class Solution {
    public List<List<Integer>> shiftGrid(int[][] grid, int k) {
        int m = grid.length;
        int n = grid[0].length;

        List<List<Integer>> res = new ArrayList<>();
        int[] arr = new int[m*n];

        for(int i=0; i<m; i++){
            for(int j=0; j<n; j++){
                arr[(n*i+j+k)%(m*n)] = grid[i][j];
            }
        }

        for(int i=0; i<m; i++){
            ArrayList<Integer> a = new ArrayList<>();
            for(int j=0; j<n; j++){
               a.add(arr[(n*i+j)%(m*n)]);
            }
            res.add(a);
        }

        return res;


    }
}
