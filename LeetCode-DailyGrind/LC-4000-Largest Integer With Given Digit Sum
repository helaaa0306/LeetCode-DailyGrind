class Solution {
    public int largestInteger(int n, int s) {
        if(n*9<s) return -1;
        int res = 0;

        while(s>0 && n>0){
            if(s/9 < 1){
                res = res*10 + s;
                n--;
                break;
            }

            res = res*10+9;
            s-=9;
            n--;

        }
        while(n>0){
            res*=10;
            n--;
        }

        return res;
    }
}
