class Solution {
    public int minimumPushes(String w) {
        int n = w.length();
        int cost=0;

        int[] cnt = new int[26];
        for(int i=0; i<n; i++){
            cnt[w.charAt(i)-'a']++;
        }

        Arrays.sort(cnt);

        int x=0, p=1;

        for(int i=25; i>=0; i--){
            if(x==8){
                x=0; p++;
            }

            x++;
            cost+=(cnt[i]*p);
        }

        return cost;
    }
}
