class Solution {
    public String removeDuplicateLetters(String s) {
        int n = s.length();
        boolean[] visited = new boolean[26];
        int[] lastOcc = new int[26];

        for (int i = 0; i < n; i++) {
            int occ = s.charAt(i) - 'a';
            lastOcc[occ] = i;
        }

        StringBuilder res = new StringBuilder();

        for (int i = 0; i < n; i++) {
            char c = s.charAt(i);
            if (!visited[c - 'a']) {
                while (res.length() > 0 && res.charAt(res.length() - 1) > c &&
                        lastOcc[res.charAt(res.length() - 1) - 'a'] > i) {

                    visited[res.charAt(res.length() - 1) - 'a'] = false;
                    res.deleteCharAt(res.length() - 1);

                }
                visited[c - 'a'] = true;

                res.append(c);
            }
        }

        return res.toString();
    }
}
