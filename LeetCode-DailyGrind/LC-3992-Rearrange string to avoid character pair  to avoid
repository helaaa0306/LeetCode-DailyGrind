class Solution {
    public String rearrangeString(String s, char x, char y) {
        StringBuilder ych = new StringBuilder();
        StringBuilder xch = new StringBuilder();
        StringBuilder ch = new StringBuilder();

        for(int i=0; i<s.length(); i++){
            char c = s.charAt(i);
            if(c==x){
                xch.append(x);
            }else if(c==y){
                ych.append(y);
            }else{
                ch.append(c);
            }
        }

        String t = ych.toString() + xch.toString() + ch.toString();

        return t;
    }
}
