//Easy marked, straigh-forward problem 

class Solution {
    public int findGCD(int[] nums) {
        int n = nums.length;
        int min = 1000, max = 1;

        for(int i=0; i<n ; i++){
            if(nums[i]<min) min = nums[i];

            if(nums[i]>max) max = nums[i];
        }

        return gcd(max, min);
    }

    int gcd(int a, int b){
        return b==0 ? a : gcd(b, a%b); 
    }
}
