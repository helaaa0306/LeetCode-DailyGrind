class Solution {
    public List<Integer> findMissingElements(int[] nums) {
        int n = nums.length;
        
        List<Integer> ans = new ArrayList<>();
        
        int min = nums[0];
        int max = nums[0];
        
        for(int i=1;i<n;i++){
            if(nums[i]>max) max = nums[i];
            
            if(nums[i]<min) min = nums[i];
            
        }
        Set<Integer> store = new HashSet<>();
        for (int num : nums) {
            store.add(num);
        }
        
        while(min<=max){
            if(!store.contains(min)) ans.add(min);
            
            min++;
        }
        
        return ans;
    }
}
