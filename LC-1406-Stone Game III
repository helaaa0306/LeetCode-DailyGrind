class Solution {
    int[] t = new int[50005];

    public String stoneGameIII(int[] stoneValue) {
        int n = stoneValue.length;

        Arrays.fill(t, -1);

        int diff = solve(0, stoneValue);

        if (diff>0)
            return "Alice";
        else if (diff==0)
            return "Tie";
        else
            return "Bob";
    }

    int solve(int i, int[] stone){
        int n = stone.length;

        if(i>=n) return 0;

        if(t[i]!=-1) return t[i];

        t[i] = stone[i] - solve(i+1, stone);

        if(i+1<n){
            t[i] = Math.max(t[i], stone[i] + stone[i+1] - solve(i+2, stone));
        }

         if(i+2<n){
            t[i] = Math.max(t[i], stone[i] + stone[i+1] + stone[i+2] - solve(i+3, stone));
        }

        return t[i];
        
    }
}
