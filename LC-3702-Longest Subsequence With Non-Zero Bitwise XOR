//Analyze the problem

class Solution {
    public int longestSubsequence(int[] nums) {
        int n = nums.length;
        int xor = 0;
        boolean zero = true;

        for(int i=0; i<n; i++){
            xor = xor^nums[i];

            if(nums[i] != 0) zero = false;
        }

        if(zero) return 0;

        if(xor==0) return n-1;
        return n; 
    }
}
