class Solution {
    public int maxProduct(int[] nums) {
        int max1=0, max2=0;

        for(int i=0; i<nums.length; i++){
            if(nums[i]>max1){
                max2 = max1;
                max1 = nums[i];
            }

            else if(nums[i]>max2){
                max2 = nums[i];
            }
        }
        int p = (max1-1)*(max2-1);
        return p;
    }
}

class Solution {
    public int maxProduct(int[] nums) {
        Arrays.sort(nums);
        int n = nums.length;

        int a = (nums[0]-1)*(nums[1]-1);
        int b = (nums[n-1]-1)*(nums[n-2]-1);

        int p = Math.max(a, b);

        return p;
    }
}
