1) Sliding window

class Solution {
    public boolean containsNearbyDuplicate(int[] nums, int k) {
        int n = nums.length;
        int i=0, j=0;

        HashSet<Integer> set = new HashSet<>();

        while(i<n && j<n){
            if(j-i>k) {
                set.remove(nums[i]);
                i++; 
            }

            if(set.contains(nums[j]) && j-i <= k){
                return true;
            }
            set.add(nums[j]);
            j++;
        }

        return false;
    }
}

2)Hashmap

class Solution {
    public boolean containsNearbyDuplicate(int[] nums, int k) {
        int n = nums.length;

        HashMap<Integer, Integer> cnt = new HashMap<>();

        for(int i=0; i<n; i++){
            if(cnt.containsKey(nums[i])){
                if((i-cnt.get(nums[i]))<=k) return true;
            }
            
            cnt.put(nums[i], i);
            
        }

        return false;
    }
}

