class Solution {
    public int maxActiveSectionsAfterTrade(String s) {
        int n = s.length();
        ArrayList<Integer> count0 = new ArrayList<>();
        int cnt=0;

        for(int i=0; i<n; i++){
            if(s.charAt(i)=='0') cnt++;
            else{
                if(cnt>0) count0.add(cnt);
                cnt=0;
            }
        }
        if(cnt>0) count0.add(cnt);

        int max = 0;

        for(int i=0; i<count0.size()-1; i++){
            max = Math.max(max, count0.get(i)+count0.get(i+1));
        }

        int count=0;
        for(int i=0; i<n; i++){
            if(s.charAt(i)=='1') count++;
            
        }

        return max+count;
    }
}
