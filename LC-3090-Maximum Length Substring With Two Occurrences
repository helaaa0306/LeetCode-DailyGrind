//Analysis the problem statement

class Solution {
    public int maximumLengthSubstring(String s) {
        int[] cnt = new int[26];

        int left = 0, l=0, max = 0;

        for(int i=0; i<s.length(); i++){
            char ch = s.charAt(i);
            cnt[ch-'a']++;

            while(cnt[ch-'a']>2){
                cnt[s.charAt(left)-'a']--;
                left++;
            }

            max = Math.max(max, i-left+1);
        }

        return max;
    }
}
