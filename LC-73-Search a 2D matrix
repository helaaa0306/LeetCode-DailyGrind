//Simple problem 

class Solution {
    public boolean searchMatrix(int[][] matrix, int target) {
        int m = matrix.length;
        int n = matrix[0].length;

        int[] arr = new int[m*n];
        int k=0;

        for(int i=0; i<m; i++){
            for(int j=0; j<n; j++){
                arr[k] = matrix[i][j];
                k++;
            }
        }

        int s=0, e=m*n-1;
        while(s<=e){
            int mid = s+(e-s)/2;

            if(arr[mid]>target) {
                e = mid-1;
            }else if(arr[mid]<target){
                s = mid + 1;
            }else{
                return true;
            }
        }

        return false;
    }
}
