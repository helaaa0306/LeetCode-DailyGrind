//Using for loop

class Solution {
    public int missingMultiple(int[] nums, int k) {
        int n = nums.length;
        
        Arrays.sort(nums);
        int x = k;
        
        for(int i=0; i<n; i++){
            if(k==nums[i]){
                k+=x;
            }
        }
        
        return k;
    }
}

