class Solution {
    public int[] resultArray(int[] nums) {
        int n = nums.length;
        ArrayList<Integer> arr1 = new ArrayList<>();
        ArrayList<Integer> arr2 = new ArrayList<>();

        arr1.add(nums[0]);
        arr2.add(nums[1]);

        for(int i=2; i<n; i++){
            int m = arr1.size()-1;
            int s = arr2.size()-1;

            if(arr1.get(m) > arr2.get(s)){
                arr1.add(nums[i]);
            }else{
                arr2.add(nums[i]);
            }
        }

        int[] res = new int[n];
        for(int i=0; i<arr1.size(); i++){
            res[i] = arr1.get(i);
        }
        for(int i=arr1.size(); i<n; i++){
            res[i] = arr2.get(i - (arr1.size()));
        }

        return res;
    }
}
